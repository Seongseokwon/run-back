# 로컬: docker compose up -d 로 띄운 Postgres
DATABASE_URL="postgresql://runback:runback_local@localhost:5432/runback?schema=public"

# 프로덕션(Neon)은 풀러 엔드포인트를 쓴다. 서버리스는 호출마다 커넥션을 열기 때문에
# 직결 URL 을 쓰면 커넥션이 고갈된다.
#   DATABASE_URL="postgresql://...@ep-xxx-pooler.<region>.aws.neon.tech/runback?sslmode=require"

# 소셜 제공자 식별자를 해시할 때 섞는 값 (PRD §9.8 — 원본을 저장하지 않는다).
# ⚠️ 이 값이 바뀌면 기존 사용자가 전부 다른 사람이 된다. 한 번 정하면 바꾸지 않는다.
AUTH_ID_PEPPER="change-me-to-a-long-random-string"

# Auth.js (F-16). openssl rand -base64 32 또는 npx auth secret
AUTH_SECRET=""

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 REST API 키
AUTH_KAKAO_ID=""
# 카카오 개발자 콘솔 > 카카오 로그인 > 보안 > Client Secret (활성화 필요)
AUTH_KAKAO_SECRET=""

# 이메일+비밀번호 로그인 (PRD §9.3 예외). 명시적 opt-in — 환경으로 자동 판단하지 않는다.
# ⚠️ 프로덕션에서 켜려면 개인정보처리방침의 처리 항목에 이메일을 넣어야 한다
AUTH_PASSWORD_LOGIN=""

# 탈퇴 유예가 지난 계정을 파기하는 Cron 을 보호한다 (/api/cron/purge).
# ⚠️ 이 Cron 이 돌지 않으면 방침의 "15일 이내 삭제"가 거짓말이 된다.
CRON_SECRET=""
