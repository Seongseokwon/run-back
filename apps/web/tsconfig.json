{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // 워크스페이스 패키지가 상대 경로에 .ts 확장자를 붙여 import 한다.
    // Node 의 타입 스트리핑이 그걸 요구하기 때문이고, 소비자 쪽에서 허용해 주면 된다.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "incremental": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-agent/types/**/*.ts",
    ".next-agent/dev/types/**/*.ts",
    ".next-agent-build/types/**/*.ts",
    ".next-agent-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
